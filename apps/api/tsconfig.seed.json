// Self-contained (does not extend @dos/config/typescript/*) as a deliberate
// exception: ts-node fails to resolve a multi-level relative "extends"
// chain through pnpm's symlinked node_modules (a known ts-node/pnpm
// interaction, unrelated to this project's config), which only affects
// ts-node — `tsc`/`nest build` resolve the same chain correctly. Used only
// by `pnpm prisma:seed`.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["prisma/seed.ts"]
}
