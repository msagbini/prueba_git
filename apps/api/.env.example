NODE_ENV=development
PORT=3000

# Restricted role (no BYPASSRLS) — used by the running API.
DATABASE_URL=postgresql://dos_app:dos_app_password@localhost:5432/dos?schema=public

# Privileged role (BYPASSRLS) — used only by `prisma migrate`.
MIGRATION_DATABASE_URL=postgresql://dos_migrator:dos_migrator_password@localhost:5432/dos?schema=public

JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGIN=http://localhost:5173

# Stripe (Fase 4 monetization) — optional; billing checkout/webhooks
# degrade to a clear 503 when unset. See docs/technical-log/phase-4.md.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing?checkout=canceled

# SMTP (Fase 9 transactional email) — optional; without SMTP_HOST,
# verification/reset/invitation emails log to the console instead of
# sending. See docs/technical-log/phase-9.md.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=replace-with-a-real-smtp-password
# SMTP_FROM=DOS <no-reply@dos.example.com>
WEB_APP_URL=http://localhost:5173
