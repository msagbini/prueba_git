{
  "name": "dos-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Operations System (DOS) - multi-tenant SaaS for field service business operations.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "docs:api": "turbo run docs:api",
    "docs:check-readmes": "node scripts/check-readmes.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@dos/config": "workspace:*",
    "@commitlint/config-conventional": "^19.5.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "lodash@4.17.21": "^4.18.1",
      "js-yaml@4.1.0": "^4.3.1",
      "file-type@20.4.1": "^21.3.2",
      "qs@6.14.2": "^6.15.3",
      "body-parser@1.20.4": "^1.20.6",
      "multer@2.0.2": "^2.2.0"
    }
  }
}
